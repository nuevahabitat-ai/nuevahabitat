# NuevaHabitat · Variables de entorno
# Copia este archivo como .env.local y rellena los valores

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Email (Resend o similar)
RESEND_API_KEY=re_xxx
# Contacto público en web, footers, JSON-LD y emails al cliente
CONTACT_EMAIL=info@nuevahabitat.com
# Notificaciones internas (leads, registro, panel) — recibe lo mismo que CONTACT_EMAIL
ADMIN_EMAIL=admin.nuevahabitat@gmail.com

# Analytics — ID de medición GA4 (Admin → Flujos de datos)
# Pegar en js/seo.js → gaId, o definir NH_GA_ID antes de cargar seo.js
GA_MEASUREMENT_ID=G-56W7QEZ2HQ
