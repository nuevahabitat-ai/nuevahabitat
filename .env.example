# NuevaHabitat · Variables de entorno
# Copia este archivo como .env.local y rellena los valores

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVICE ROLE — solo servidor (Vercel). Acepta cualquiera de estos nombres:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth (opcional — login Supabase)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Google Calendar (disponibilidad panel → citas automáticas)
#
# OPCIÓN A — OAuth (recomendada si Google bloquea claves de cuenta de servicio)
# Usa el cliente OAuth "nuevahabitat" + refresh token de admin.nuevahabitat@gmail.com
GOOGLE_CLIENT_ID=311723462282-xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REFRESH_TOKEN=1//0xxxxx
GOOGLE_CALENDAR_ID=admin.nuevahabitat@gmail.com
GOOGLE_CALENDAR_ID_INFO=info@nuevahabitat.com
#
# OPCIÓN B — Cuenta de servicio (si tu proyecto permite crear claves JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email (Resend o similar)
RESEND_API_KEY=re_xxx
# Contacto público en web, footers, JSON-LD y emails al cliente
CONTACT_EMAIL=info@nuevahabitat.com
# Notificaciones internas (leads, registro, panel) — recibe lo mismo que CONTACT_EMAIL
ADMIN_EMAIL=admin.nuevahabitat@gmail.com

# Analytics — ID de medición GA4 (Admin → Flujos de datos)
# Pegar en js/seo.js → gaId, o definir NH_GA_ID antes de cargar seo.js
GA_MEASUREMENT_ID=G-56W7QEZ2HQ

# Stripe — pagos honorarios panel (solo servidor excepto publishable)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Webhook: Stripe Dashboard → endpoint https://www.nuevahabitat.com/api/stripe-webhook
# Evento: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxx
